{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
    "name": "Chess Engine Dev Env",
    "build": {
        "dockerfile": "../Dockerfile",
        "target": "development",
        "context": ".."
    },
    "workspaceFolder": "/app",
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "forwardPorts": [
        8000,
        8888,
        6006
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "ms-python.pylance",
                "ms-python.debugpy",
                "ms-python.mypy-type-checker",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "christian-kohler.path-intellisense",
                "aaron-bond.better-comments",
                "ms-azuretools.vscode-docker",
                "charliermarsh.ruff",
                "astral.uv",
                "github.vscode-github-actions"
            ],
            "settings": {
                "cmake.sourceDirectory": "${workspaceFolder}",
                "python.terminal.activateEnvironment": false,
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.linting.flake8Enabled": false,
                "python.linting.mypyEnabled": true,
                "python.languageServer": "Pylance",
                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.autoImportCompletions": true,
                "pylance.autoImportCompletions": true,
                "python.linting.pylintArgs": [
                    "--disable=C0111,C0103,C0303,C0330,C0326,W0611,E1101,C0111,C0103,R0903,R0913,R0914",
                    "--disable=import-error,unused-import,line-too-long,trailing-whitespace",
                    "--ignore=tests,notebooks,search_profiler.py,unit_tests.py"
                ],
                "python.linting.pylintPath": "pylint",
                "mypy-type-checker.args": [
                    "--config-file=pyproject.toml"
                ],
                "mypy-type-checker.severity": {
                    "error": "Error",
                    "note": "Information"
                },
                "mypy-type-checker.runUsingActiveInterpreter": true,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit",
                        "source.fixAll": "explicit"
                    }
                },
                "[cpp]": {
                    "editor.defaultFormatter": "ms-vscode.cpptools",
                    "editor.formatOnSave": true
                },
                "files.autoSave": "onFocusChange",
                "ruff.organizeImports": true,
                "ruff.fixAll": true,
                "ruff.nativeServer": "on",
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/.ruff_cache": true,
                    "**/.mypy_cache": true,
                    ".docker-cache/": true,
                    "**/*.egg-info": true,
                    "**/.ipynb_checkpoints": true
                },
                "jupyter.askForKernelRestart": false,
                "jupyter.interactiveWindow.creationMode": "perFile",
                "better-comments.tags": [
                    {
                        "tag": "!",
                        "color": "#FF2D00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "?",
                        "color": "#3498DB",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "todo",
                        "color": "#FF8C00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "*",
                        "color": "#98C379",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    }
                ],
                "python.analysis.exclude": [
                    "**/tests/**",
                    "**/notebooks/**",
                    "**/search_profiler.py",
                    "**/unit_tests.py"
                ]
            }
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "PYTHONPATH": "/app"
    }
}
