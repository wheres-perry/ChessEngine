{
    "$schema": "https://json.schemastore.org/devcontainer.json",
    "name": "Chess Engine Dev Env",
    "build": {
        "dockerfile": "Dockerfile.dev",
        "context": "."
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "forwardPorts": [
        8000,
        8888,
        6006
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                // Python Development
                "ms-python.python",
                "ms-python.pylance",
                "ms-python.debugpy",
                // Type Checking
                "ms-python.mypy-type-checker",
                // Jupyter Notebook Support
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                // AI Assistant
                "GitHub.copilot",
                "GitHub.copilot-chat",
                // Development Tools
                "christian-kohler.path-intellisense",
                "aaron-bond.better-comments",
                // Docker & Containers
                "ms-azuretools.vscode-docker",
                // Code Quality (Ruff for formatting/basic linting)
                "charliermarsh.ruff"
            ],
            "settings": {
                // Python interpreter
                "python.defaultInterpreterPath": "python",
                "python.terminal.activateEnvironment": true,
                // Enable linting but with specific configurations
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.linting.flake8Enabled": false,
                "python.linting.mypyEnabled": true,
                // Pylance - Language Server 
                "python.languageServer": "Pylance",
                "python.analysis.typeCheckingMode": "basic", // Basic mode so it doesn't conflict with MyPy
                "python.analysis.autoImportCompletions": true,
                "pylance.autoImportCompletions": true,
                // Pylint configuration - focus on code quality issues
                "python.linting.pylintArgs": [
                    "--disable=C0111,C0103,C0303,C0330,C0326,W0611,E1101,C0111,C0103,R0903,R0913,R0914",
                    "--disable=import-error,unused-import,line-too-long,trailing-whitespace"
                ],
                // MyPy - Strict Type Checking
                "mypy-type-checker.args": [
                    "--config-file=pyproject.toml"
                ],
                "mypy-type-checker.severity": {
                    "error": "Error",
                    "note": "Information"
                },
                "mypy-type-checker.runUsingActiveInterpreter": true,
                // Ruff - Formatting & Basic Linting
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit",
                        "source.fixAll": "explicit"
                    }
                },
                "files.autoSave": "onFocusChange",
                "ruff.organizeImports": true,
                "ruff.fixAll": true,
                "ruff.nativeServer": "on",
                // File Explorer - Hide cache and config files
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/.ruff_cache": true,
                    "**/.mypy_cache": true,
                    "**/ruff.toml": true
                },
                // Jupyter Configuration
                "jupyter.askForKernelRestart": false,
                "jupyter.interactiveWindow.creationMode": "perFile",
                // Better Comments Configuration remains unchanged
                "better-comments.tags": [
                    {
                        "tag": "!",
                        "color": "#FF2D00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "?",
                        "color": "#3498DB",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "todo",
                        "color": "#FF8C00",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    },
                    {
                        "tag": "*",
                        "color": "#98C379",
                        "strikethrough": false,
                        "underline": false,
                        "backgroundColor": "transparent",
                        "bold": false,
                        "italic": false
                    }
                ]
            }
        }
    },
    "postCreateCommand": "poetry install --no-interaction && poetry run pip install -e . && pre-commit install",
    "remoteUser": "vscode",
    "containerEnv": {
        "PYTHONPATH": "/workspace"
    }
}